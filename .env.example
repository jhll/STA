# Plantilla de Configuración para STA-FCQB
# Copia este archivo como `.env.local` en tu máquina de desarrollo.
# Las variables que comienzan con VITE_ son detectadas automáticamente por Vite.

# URL de tu proyecto de Supabase (Console > Project Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon Key pública de tu proyecto de Supabase (Console > Project Settings > API)
VITE_SUPABASE_ANON_KEY=tu-supabase-anon-key

# Clave de API de Google Gemini (Google AI Studio) para el semáforo inteligente de riesgo
VITE_GEMINI_API_KEY=tu-api-key-de-gemini
